# ── LLM Provider ──────────────────────────────────────────────────────────────
# Select which provider to use: huggingface | openai | gemini | claude
# Default: huggingface (Qwen)
# Override per service in docker-compose.yml — see README for usage.
LLM_PROVIDER=huggingface

# ── HuggingFace (default — Qwen2.5) ───────────────────────────────────────────
# Get your token at: https://huggingface.co/settings/tokens
# Requires a Pro account for Qwen/Qwen2.5-72B-Instruct.
# Free alternative: Qwen/Qwen2.5-7B-Instruct (lower quality)
HUGGINGFACE_API_KEY=hf_...
HUGGINGFACE_MODEL=Qwen/Qwen2.5-72B-Instruct

# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Google Gemini ──────────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-1.5-flash

# ── Anthropic / Claude ─────────────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Google Cloud / BigQuery ────────────────────────────────────────────────────
GCP_PROJECT_ID=your-project-id
BQ_DATASET=infra_gestion
GOOGLE_APPLICATION_CREDENTIALS=/app/creds/service_account.json

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:changeme@redis:6379/0
REDIS_PASSWORD=changeme

# ── Security ───────────────────────────────────────────────────────────────────
API_SECRET_KEY=changeme-in-production
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ── Misc ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
